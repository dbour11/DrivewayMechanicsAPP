# ── Environment / secrets ────────────────────────────────────────────────
# Never commit real env files. .env.example IS committed (see negation below).
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
*.local
!.env.example

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ─────────────────────────────────────────────────────────
dist/
build/
.next/
out/
.expo/
.expo-shared/
*.tsbuildinfo

# ── Supabase ─────────────────────────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
