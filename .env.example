# Driveway Mechanics — environment variable template
# Copy to `.env` (or per-app `.env.local`) and fill in the blanks.
# ONLY the two Supabase values below are public/safe to commit. Everything left
# blank is a SECRET — never commit real values; store them in the appropriate
# secret manager (Supabase Edge Function env / Netlify / EAS). See CLAUDE.md §6.
#
# Project: DrivewayMechanicsApp  (ref: pjagzuugtefeeurmnrrs, region us-east-1)

# ── Supabase ─────────────────────────────────────────────────────────────
# Public — safe for client bundles.
SUPABASE_URL=https://pjagzuugtefeeurmnrrs.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_jwY03xqbgCqQDSPBIGoF9w_oc5kO3MO
# SECRET — server / Edge Functions only. NEVER expose to the client. Leave blank here.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=        # public (client) — fill from Stripe dashboard
STRIPE_SECRET_KEY=             # SECRET — server only
STRIPE_WEBHOOK_SECRET=         # SECRET — server only

# ── Twilio ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=            # SECRET — server only
TWILIO_AUTH_TOKEN=             # SECRET — server only
TWILIO_MESSAGING_SERVICE_SID=  # SECRET — server only

# ── Mapbox ───────────────────────────────────────────────────────────────
MAPBOX_PUBLIC_TOKEN=           # public (client) — fill from Mapbox account
MAPBOX_ACCESS_TOKEN=           # SECRET — server only

# ── Client-exposed mirrors ───────────────────────────────────────────────
# Expo requires the EXPO_PUBLIC_ prefix to reach the mobile client.
# Next.js requires the NEXT_PUBLIC_ prefix to reach the web client.
# Only ever mirror PUBLIC values here — never secrets.
EXPO_PUBLIC_SUPABASE_URL=https://pjagzuugtefeeurmnrrs.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jwY03xqbgCqQDSPBIGoF9w_oc5kO3MO
NEXT_PUBLIC_SUPABASE_URL=https://pjagzuugtefeeurmnrrs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jwY03xqbgCqQDSPBIGoF9w_oc5kO3MO
